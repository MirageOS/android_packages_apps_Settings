<?xml version="1.0" encoding="utf-8"?>
<!--
  Header da tela "Sobre o dispositivo" (estilo Motorola / MD3 Expressive).
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/about_device_header_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Banner -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:background="@drawable/about_banner_bg"
        android:clipToOutline="true">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/about_banner"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/about_banner_scrim"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/about_rom_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_device_rom_name"
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"/>

            <TextView
                android:id="@+id/about_android_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#FFFFFFFF"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Tiles: nome do dispositivo + armazenamento -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/about_tile_device"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="140dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/about_tile_bg"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="4dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_about_phone"
                android:tint="@color/settingslib_materialColorPrimary"
                android:importantForAccessibility="no"/>

            <TextView
                android:id="@+id/about_device_name_title"
                android:text="@string/about_device_name_tile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/settingslib_materialColorOnSurface"/>

            <TextView
                android:id="@+id/about_device_name_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/settingslib_materialColorOnSurfaceVariant"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/about_tile_storage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="140dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/about_tile_bg"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="4dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_about_storage"
                android:tint="@color/settingslib_materialColorPrimary"
                android:importantForAccessibility="no"/>

            <TextView
                android:id="@+id/about_storage_title"
                android:text="@string/about_device_storage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/settingslib_materialColorOnSurface"/>

            <TextView
                android:id="@+id/about_storage_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/settingslib_materialColorOnSurfaceVariant"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Maintainer -->
    <LinearLayout
        android:id="@+id/about_tile_maintainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp"
        android:background="@drawable/about_card_bg">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_about_maintainer"
            android:tint="@color/settingslib_materialColorPrimary"
            android:importantForAccessibility="no"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_device_maintainer"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/settingslib_materialColorOnSurface"/>

            <TextView
                android:id="@+id/about_maintainer_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/settingslib_materialColorOnSurfaceVariant"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Specs: RAM, câmera, tela -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/about_card_bg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="@string/about_device_ram"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/settingslib_materialColorOnSurface"/>

        <TextView
            android:id="@+id/about_ram_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/settingslib_materialColorOnSurfaceVariant"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/about_device_camera"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/settingslib_materialColorOnSurface"/>

        <TextView
            android:id="@+id/about_camera_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/settingslib_materialColorOnSurfaceVariant"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/about_device_display"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/settingslib_materialColorOnSurface"/>

        <TextView
            android:id="@+id/about_display_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/settingslib_materialColorOnSurfaceVariant"/>
    </LinearLayout>

</LinearLayout>
