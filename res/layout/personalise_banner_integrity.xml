<?xml version="1.0" encoding="utf-8"?>
<!-- Banner do Integrity: shape girando devagar atrás do escudo. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">
    <FrameLayout
        android:id="@+id/banner_integrity_root"
        android:layout_width="match_parent"
        android:layout_height="176dp"
        android:background="@drawable/personalise_banner_bg"
        android:clipToOutline="true">
        <ImageView
            android:id="@+id/banner_integrity_shape"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-48dp"
            android:layout_marginEnd="-48dp"
            android:alpha="0.14"
            android:src="@drawable/personalise_shape_flower"
            android:tint="#FFFFFFFF"
            android:importantForAccessibility="no"/>

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="24dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/personalise_shape_cookie"
            android:backgroundTint="@color/settingslib_materialColorTertiary"
            android:importantForAccessibility="no">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_personalise_integrity"
                android:tint="@color/settingslib_materialColorOnPrimary"
                android:importantForAccessibility="no"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/personalise_integrity_category"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/settingslib_materialColorOnPrimaryContainer"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/personalise_banner_integrity_desc"
                android:textSize="14sp"
                android:alpha="0.8"
                android:textColor="@color/settingslib_materialColorOnPrimaryContainer"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
