<?xml version="1.0" encoding="utf-8"?>
<!--
    Banner ao vivo do desfoque das Configurações rápidas. O painel mostra o wallpaper desfocado
    com a intensidade escolhida no slider; o que está fora dele continua nítido para comparar.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">
    <FrameLayout
        android:id="@+id/blur_banner_root"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/personalise_banner_bg_alt"
        android:clipToOutline="true"
        android:contentDescription="@string/blur_preview_description">

        <include
            android:id="@+id/blur_scene_sharp"
            layout="@layout/display_blur_scene"/>

        <FrameLayout
            android:id="@+id/blur_panel"
            android:layout_width="match_parent"
            android:layout_height="118dp"
            android:layout_gravity="top"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/display_blur_panel_bg"
            android:clipToOutline="true">

            <!-- Tamanho e deslocamento acertados pelo controller para alinhar com a cena nítida. -->
            <include
                android:id="@+id/blur_scene_blurred"
                layout="@layout/display_blur_scene"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <View
                android:id="@+id/blur_panel_tint"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.5"
                android:background="@drawable/display_blur_panel_bg"
                android:backgroundTint="@color/settingslib_materialColorSurfaceContainer"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="16dp"
                android:importantForAccessibility="no">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/personalise_shape_squircle"
                        android:backgroundTint="@color/settingslib_materialColorPrimaryContainer">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_airplanemode_active"
                            android:tint="@color/settingslib_materialColorOnPrimaryContainer"/>
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/personalise_shape_cookie"
                        android:backgroundTint="@color/settingslib_materialColorSurfaceContainerHigh">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_dynamic_island_flashlight"
                            android:tint="@color/settingslib_materialColorOnSurfaceVariant"/>
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/personalise_shape_squircle"
                        android:backgroundTint="@color/settingslib_materialColorSurfaceContainerHigh">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_personalise_dark_mode"
                            android:tint="@color/settingslib_materialColorOnSurfaceVariant"/>
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/personalise_shape_cookie"
                        android:backgroundTint="@color/settingslib_materialColorSurfaceContainerHigh">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_media_stream"
                            android:tint="@color/settingslib_materialColorOnSurfaceVariant"/>
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/display_blur_pill"
                    android:backgroundTint="@color/settingslib_materialColorSurfaceContainerHighest"
                    android:orientation="horizontal"
                    android:weightSum="10">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="6"
                        android:background="@drawable/display_blur_pill"
                        android:backgroundTint="@color/settingslib_materialColorPrimary"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/blur_banner_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/display_blur_chip_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:importantForAccessibility="no"/>
    </FrameLayout>
</FrameLayout>
