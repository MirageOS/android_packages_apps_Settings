<?xml version="1.0" encoding="utf-8"?>
<!-- Banner animado das Configurações rápidas: os blocos acendem um por vez. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">
    <FrameLayout
        android:id="@+id/banner_qs_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="176dp"
        android:background="@drawable/personalise_banner_bg_alt"
        android:clipToOutline="true">
        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-44dp"
            android:layout_marginBottom="-52dp"
            android:alpha="0.14"
            android:src="@drawable/personalise_shape_cookie"
            android:tint="#FFFFFFFF"
            android:importantForAccessibility="no"/>

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="-16dp"
            android:layout_marginStart="-16dp"
            android:alpha="0.1"
            android:src="@drawable/personalise_shape_clover"
            android:tint="#FFFFFFFF"
            android:importantForAccessibility="no"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:importantForAccessibility="no">
            <FrameLayout
                android:id="@+id/banner_qs_tile_1"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/personalise_shape_squircle"
                android:backgroundTint="@color/settingslib_materialColorSurfaceContainerHigh">
                <ImageView
                    android:id="@+id/banner_qs_icon_1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_airplanemode_active"
                    android:tint="@color/settingslib_materialColorOnSurfaceVariant"
                    android:importantForAccessibility="no"/>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/banner_qs_tile_2"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/personalise_shape_cookie"
                android:backgroundTint="@color/settingslib_materialColorSurfaceContainerHigh">
                <ImageView
                    android:id="@+id/banner_qs_icon_2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_dynamic_island_flashlight"
                    android:tint="@color/settingslib_materialColorOnSurfaceVariant"
                    android:importantForAccessibility="no"/>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/banner_qs_tile_3"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/personalise_shape_squircle"
                android:backgroundTint="@color/settingslib_materialColorSurfaceContainerHigh">
                <ImageView
                    android:id="@+id/banner_qs_icon_3"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_personalise_dark_mode"
                    android:tint="@color/settingslib_materialColorOnSurfaceVariant"
                    android:importantForAccessibility="no"/>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/banner_qs_tile_4"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/personalise_shape_cookie"
                android:backgroundTint="@color/settingslib_materialColorSurfaceContainerHigh">
                <ImageView
                    android:id="@+id/banner_qs_icon_4"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_media_stream"
                    android:tint="@color/settingslib_materialColorOnSurfaceVariant"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="84dp"
            android:paddingBottom="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/personalise_banner_qs_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/settingslib_materialColorOnSecondaryContainer"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/personalise_banner_qs_desc"
                android:textSize="14sp"
                android:alpha="0.8"
                android:textColor="@color/settingslib_materialColorOnSecondaryContainer"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
