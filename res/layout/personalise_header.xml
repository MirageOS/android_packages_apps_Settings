<?xml version="1.0" encoding="utf-8"?>
<!--
Header da tela "Personalise" (estilo Motorola / MD3 Expressive):
preview do plano de fundo + atalhos para estilo, tema escuro, texto, tela de bloqueio e tela.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/personalise_header_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Preview + dois atalhos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Preview do plano de fundo / tela de bloqueio -->
        <FrameLayout
            android:id="@+id/personalise_preview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="296dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/personalise_hero_bg"
            android:clipToOutline="true"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/personalise_preview_description">

            <ImageView
                android:id="@+id/personalise_preview_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/personalise_hero_scrim"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="40dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:importantForAccessibility="no">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="hh&#10;mm"
                    android:format24Hour="HH&#10;mm"
                    android:gravity="center"
                    android:lineSpacingMultiplier="0.8"
                    android:fontFamily="sans-serif-light"
                    android:textSize="76sp"
                    android:textColor="#FFFFFFFF"/>

                <TextClock
                    android:id="@+id/personalise_date_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:format12Hour="EEE, d MMM"
                    android:format24Hour="EEE, d MMM"
                    android:textSize="14sp"
                    android:textColor="#FFFFFFFF"/>
            </LinearLayout>

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="20dp"
                android:src="@drawable/ic_lock_closed"
                android:tint="#FFFFFFFF"
                android:importantForAccessibility="no"/>
        </FrameLayout>

        <!-- Coluna da direita -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/personalise_tile_dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="144dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/personalise_tile_bg"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="4dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/personalise_icon_chip_bg">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_personalise_dark_mode"
                        android:tint="@color/settingslib_materialColorOnSecondaryContainer"
                        android:importantForAccessibility="no"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/personalise_dark_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dark_ui_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/settingslib_materialColorOnSurface"/>
                <TextView
                    android:id="@+id/personalise_dark_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textSize="14sp"
                    android:textColor="@color/settingslib_materialColorOnSurfaceVariant"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/personalise_tile_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="144dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/personalise_tile_bg"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="4dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/personalise_icon_chip_bg">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_personalise_text"
                        android:tint="@color/settingslib_materialColorOnSecondaryContainer"
                        android:importantForAccessibility="no"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/personalise_text_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/accessibility_text_reading_options_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/settingslib_materialColorOnSurface"/>

                <TextView
                    android:id="@+id/personalise_text_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/personalise_text_sample"
                    android:textSize="14sp"
                    android:textColor="@color/settingslib_materialColorOnSurfaceVariant"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Plano de fundo e estilo (card largo) -->
    <LinearLayout
        android:id="@+id/personalise_tile_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="88dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="@drawable/personalise_tile_bg"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/personalise_icon_chip_bg">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_personalise"
                android:tint="@color/settingslib_materialColorOnSecondaryContainer"
                android:importantForAccessibility="no"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/personalise_wallpaper_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/style_and_wallpaper_settings_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/settingslib_materialColorOnSurface"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wallpaper_dashboard_summary"
                android:textSize="14sp"
                android:textColor="@color/settingslib_materialColorOnSurfaceVariant"/>
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_personalise_chevron"
            android:tint="@color/settingslib_materialColorOnSurfaceVariant"
            android:importantForAccessibility="no"/>
    </LinearLayout>

    <!-- Tela de bloqueio + Tela -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/personalise_tile_lockscreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/personalise_tile_bg"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/personalise_icon_chip_bg">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_lock_closed"
                        android:tint="@color/settingslib_materialColorOnSecondaryContainer"
                        android:importantForAccessibility="no"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/personalise_lockscreen_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lockscreen_settings_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/settingslib_materialColorOnSurface"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/personalise_tile_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/personalise_tile_bg"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/personalise_icon_chip_bg">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_settings_display_filled"
                        android:tint="@color/settingslib_materialColorOnSecondaryContainer"
                        android:importantForAccessibility="no"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/personalise_display_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/display_settings"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/settingslib_materialColorOnSurface"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
