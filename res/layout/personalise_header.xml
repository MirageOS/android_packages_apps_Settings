<?xml version="1.0" encoding="utf-8"?>
<!--
Header da tela "Personalise" (estilo Motorola / MD3 Expressive):
preview do plano de fundo + atalhos para estilo, tema escuro, texto, tela de bloqueio e tela.
O preview e a coluna da direita têm altura fixa (328dp) para a imagem do wallpaper não esticar o header.
Cada atalho tem um chip em forma própria e um shape grande, translúcido, no canto. Os ícones ficam
no topo e os textos embaixo, então tudo alinha igual entre os cards.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/personalise_header_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">
    <!-- Preview + dois atalhos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <!-- Preview do plano de fundo / tela de bloqueio -->
        <FrameLayout
            android:id="@+id/personalise_preview"
            android:layout_width="0dp"
            android:layout_height="328dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/personalise_hero_bg"
            android:clipToOutline="true"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/personalise_preview_description">
            <ImageView
                android:id="@+id/personalise_preview_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="false"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/personalise_hero_scrim"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:importantForAccessibility="no">
                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="hh&#10;mm"
                    android:format24Hour="HH&#10;mm"
                    android:gravity="center"
                    android:lineSpacingMultiplier="0.8"
                    android:fontFamily="sans-serif-light"
                    android:textSize="64sp"
                    android:textColor="#FFFFFFFF"/>

                <TextClock
                    android:id="@+id/personalise_date_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:format12Hour="EEE, d MMM"
                    android:format24Hour="EEE, d MMM"
                    android:textSize="14sp"
                    android:textColor="#FFFFFFFF"/>
            </LinearLayout>

            <!-- Cadeado dentro de um chip translúcido em forma de cookie -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/personalise_shape_cookie"
                android:backgroundTint="#40FFFFFF"
                android:importantForAccessibility="no">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_lock_closed"
                    android:tint="#FFFFFFFF"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
        </FrameLayout>

        <!-- Coluna da direita: mesma altura do preview, dois cards iguais -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="328dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical">
            <FrameLayout
                android:id="@+id/personalise_tile_dark"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="148dp"
                android:background="@drawable/personalise_tile_bg"
                android:clipToOutline="true"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-30dp"
                    android:layout_marginEnd="-30dp"
                    android:alpha="0.45"
                    android:src="@drawable/personalise_shape_flower"
                    android:tint="@color/settingslib_materialColorSecondaryContainer"
                    android:importantForAccessibility="no"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/personalise_shape_cookie"
                        android:backgroundTint="@color/settingslib_materialColorSecondaryContainer">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_personalise_dark_mode"
                            android:tint="@color/settingslib_materialColorOnSecondaryContainer"
                            android:importantForAccessibility="no"/>
                    </FrameLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:id="@+id/personalise_dark_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/dark_ui_title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/settingslib_materialColorOnSurface"/>

                    <TextView
                        android:id="@+id/personalise_dark_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:textColor="@color/settingslib_materialColorOnSurfaceVariant"/>
                </LinearLayout>
            </FrameLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp"/>

            <FrameLayout
                android:id="@+id/personalise_tile_text"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="148dp"
                android:background="@drawable/personalise_tile_bg"
                android:clipToOutline="true"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-30dp"
                    android:layout_marginEnd="-30dp"
                    android:alpha="0.45"
                    android:src="@drawable/personalise_shape_clover"
                    android:tint="@color/settingslib_materialColorPrimaryContainer"
                    android:importantForAccessibility="no"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/personalise_shape_squircle"
                        android:backgroundTint="@color/settingslib_materialColorPrimaryContainer">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_personalise_text"
                            android:tint="@color/settingslib_materialColorOnPrimaryContainer"
                            android:importantForAccessibility="no"/>
                    </FrameLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:id="@+id/personalise_text_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/accessibility_text_reading_options_title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/settingslib_materialColorOnSurface"/>

                    <TextView
                        android:id="@+id/personalise_text_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/personalise_text_sample"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:textColor="@color/settingslib_materialColorOnSurfaceVariant"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Plano de fundo e estilo (card largo) -->
    <FrameLayout
        android:id="@+id/personalise_tile_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="96dp"
        android:background="@drawable/personalise_tile_bg"
        android:clipToOutline="true"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="-40dp"
            android:alpha="0.45"
            android:src="@drawable/personalise_shape_flower"
            android:tint="@color/settingslib_materialColorTertiary"
            android:importantForAccessibility="no"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/personalise_shape_flower"
                android:backgroundTint="@color/settingslib_materialColorTertiary">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_personalise"
                    android:tint="@color/settingslib_materialColorOnPrimary"
                    android:importantForAccessibility="no"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/personalise_wallpaper_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/style_and_wallpaper_settings_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/settingslib_materialColorOnSurface"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/wallpaper_dashboard_summary"
                    android:textSize="14sp"
                    android:textColor="@color/settingslib_materialColorOnSurfaceVariant"/>
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_personalise_chevron"
                android:tint="@color/settingslib_materialColorOnSurfaceVariant"
                android:importantForAccessibility="no"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Tela de bloqueio + Tela -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/personalise_tile_lockscreen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:minHeight="128dp"
            android:background="@drawable/personalise_tile_bg"
            android:clipToOutline="true"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-30dp"
                android:layout_marginEnd="-30dp"
                android:alpha="0.45"
                android:src="@drawable/personalise_shape_cookie"
                android:tint="@color/settingslib_materialColorPrimaryContainer"
                android:importantForAccessibility="no"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp">
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/personalise_shape_clover"
                    android:backgroundTint="@color/settingslib_materialColorPrimaryContainer">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_lock_closed"
                        android:tint="@color/settingslib_materialColorOnPrimaryContainer"
                        android:importantForAccessibility="no"/>
                </FrameLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/personalise_lockscreen_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/lockscreen_settings_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/settingslib_materialColorOnSurface"/>
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/personalise_tile_display"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:minHeight="128dp"
            android:background="@drawable/personalise_tile_bg"
            android:clipToOutline="true"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-30dp"
                android:layout_marginEnd="-30dp"
                android:alpha="0.45"
                android:src="@drawable/personalise_shape_squircle"
                android:tint="@color/settingslib_materialColorSecondaryContainer"
                android:importantForAccessibility="no"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp">
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/personalise_shape_cookie"
                    android:backgroundTint="@color/settingslib_materialColorSecondaryContainer">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_settings_display_filled"
                        android:tint="@color/settingslib_materialColorOnSecondaryContainer"
                        android:importantForAccessibility="no"/>
                </FrameLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/personalise_display_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/display_settings"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/settingslib_materialColorOnSurface"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
