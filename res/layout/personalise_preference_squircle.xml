<?xml version="1.0" encoding="utf-8"?>
<!--
  Linha das telas Personalise e Dynamic Island: ícone dentro de um chip em forma de squircle,
  título e resumo alinhados à esquerda e o widget (switch) alinhado ao centro vertical, à direita.
  O fundo do cartão arredondado vem do adapter das preferências.
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="80dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/icon_frame"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/personalise_shape_squircle"
        android:backgroundTint="@color/personalise_chip_fill">

        <ImageView
            android:id="@android:id/icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:tint="@color/personalise_chip_icon"
            android:importantForAccessibility="no"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="false"
            android:textAppearance="?android:attr/textAppearanceListItem"
            android:textColor="@color/personalise_text_primary"
            android:textSize="16sp"/>

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?android:attr/textAppearanceListItemSecondary"
            android:textColor="@color/personalise_text_secondary"
            android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:gravity="center_vertical|end"
        android:orientation="vertical"/>
</LinearLayout>
