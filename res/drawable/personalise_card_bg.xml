<?xml version="1.0" encoding="utf-8"?>
<!--
  Fundo (surface) dos cards das telas Personalise / Sobre o dispositivo.
  Usa SurfaceContainerHigh (claro/escuro definido em personalise_colors.xml) para o card se
  destacar do fundo da tela e os shapes MD3 decorativos não ficarem "flutuando" sobre o preto.
  -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/settingslib_materialColorSurfaceContainerHigh"/>
    <corners android:radius="28dp"/>
</shape>
