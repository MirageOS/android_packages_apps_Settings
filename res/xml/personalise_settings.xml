<?xml version="1.0" encoding="utf-8"?>
<!--
  Tela "Personalise": preview do plano de fundo, atalhos de estilo e a seção Integrity
  (spoof de propriedades certificadas, keybox XML e PIF JSON), antes nas Opções do desenvolvedor,
  e a seção Dynamic Island (opções da ilha no estilo Motorola MD3).
  -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="personalise_screen"
    android:title="@string/personalise_title">

    <com.android.settingslib.widget.LayoutPreference
        android:key="personalise_header"
        android:order="0"
        android:layout="@layout/personalise_header"
        android:selectable="false"/>

    <com.android.settingslib.widget.LayoutPreference
        android:key="personalise_banner_island"
        android:order="3"
        android:layout="@layout/personalise_banner_island"
        android:selectable="false"/>

    <PreferenceCategory
        android:key="personalise_dynamic_island_category"
        android:order="5"
        android:title="@string/dynamic_island_category">

        <SwitchPreferenceCompat
            android:key="dynamic_island_enabled"
            android:layout="@layout/personalise_preference_cookie"
            android:icon="@drawable/ic_dynamic_island"
            android:title="@string/dynamic_island_enabled_title"
            android:summary="@string/dynamic_island_enabled_summary"
            settings:controller="com.android.settings.personalise.dynamicisland.DynamicIslandTogglePreferenceController"/>

        <SwitchPreferenceCompat
            android:key="dynamic_island_expand_on_tap"
            android:layout="@layout/personalise_preference_squircle"
            android:icon="@drawable/ic_dynamic_island_expand"
            android:title="@string/dynamic_island_expand_title"
            android:summary="@string/dynamic_island_expand_summary"
            android:dependency="dynamic_island_enabled"
            settings:controller="com.android.settings.personalise.dynamicisland.DynamicIslandTogglePreferenceController"/>

        <Preference
            android:key="dynamic_island_live_updates"
            android:layout="@layout/personalise_preference_flower"
            android:icon="@drawable/ic_dynamic_island_live"
            android:title="@string/dynamic_island_live_updates_title"
            android:summary="@string/dynamic_island_live_updates_summary"
            android:fragment="com.android.settings.personalise.dynamicisland.DynamicIslandLiveUpdatesFragment"
            android:dependency="dynamic_island_enabled"/>

        <Preference
            android:key="dynamic_island_position"
            android:layout="@layout/personalise_preference_clover"
            android:icon="@drawable/ic_dynamic_island_position"
            android:title="@string/dynamic_island_position_title"
            android:summary="@string/dynamic_island_position_summary"
            android:fragment="com.android.settings.personalise.dynamicisland.DynamicIslandPositionFragment"
            android:dependency="dynamic_island_enabled"/>
    </PreferenceCategory>

    <com.android.settingslib.widget.LayoutPreference
        android:key="personalise_banner_qs"
        android:order="6"
        android:layout="@layout/personalise_banner_qs"
        android:selectable="false"/>

    <PreferenceCategory
        android:key="personalise_qs_category"
        android:order="7"
        android:title="@string/qs_style_category">

        <SwitchPreferenceCompat
            android:key="qs_style_motorola"
            android:layout="@layout/personalise_preference_flower"
            android:icon="@drawable/ic_qs_style"
            android:title="@string/qs_style_motorola_title"
            android:summary="@string/qs_style_motorola_summary"
            settings:controller="com.android.settings.personalise.qs.QsStyleTogglePreferenceController"/>

        <SwitchPreferenceCompat
            android:key="qs_show_labels"
            android:layout="@layout/personalise_preference_cookie"
            android:icon="@drawable/ic_qs_labels"
            android:title="@string/qs_show_labels_title"
            android:summary="@string/qs_show_labels_summary"
            settings:controller="com.android.settings.personalise.qs.QsStyleTogglePreferenceController"/>
    </PreferenceCategory>

    <com.android.settingslib.widget.LayoutPreference
        android:key="personalise_banner_integrity"
        android:order="9"
        android:layout="@layout/personalise_banner_integrity"
        android:selectable="false"/>

    <PreferenceCategory
        android:key="personalise_integrity_category"
        android:order="10"
        android:title="@string/personalise_integrity_category">

        <SwitchPreferenceCompat
            android:key="certified_props"
            android:title="@string/cert_overlay_title"
            android:summary="@string/cert_overlay_summary"
            settings:controller="com.android.settings.personalise.CertifiedPropsPreferenceController"/>

        <com.android.settings.personalise.KeyboxDataPreference
            android:key="keybox_data_setting"
            android:title="@string/keybox_data_title"
            android:summary="@string/keybox_data_summary"
            android:defaultValue=""/>

        <com.android.settings.personalise.PifDataPreference
            android:key="pif_data_setting"
            android:title="@string/pif_data_title"
            android:summary="@string/pif_data_summary"
            android:defaultValue=""/>
    </PreferenceCategory>

</PreferenceScreen>
